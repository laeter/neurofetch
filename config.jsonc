{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Vedal",
    "padding": {
      "top": 0,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "cyan"
    },
      {
      "type": "command",
      "key": "│ ├  CPU",
      "keyColor": "cyan",
      "color": "red",
      "text": "cpu=$(top -bn1 | grep 'Cpu(s)' | awk '{print $2}' | cut -d'%' -f1); temp=$(sensors | grep 'Tctl' | awk '{print $2}'); echo \"${cpu}% | 🌡 ${temp}\""
    },
    {
      "type": "command",
      "key": "│ ├  GPU",
      "keyColor": "cyan",
      "text": "gpu=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo '0'); temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo '0'); echo \"${gpu}% | 🌡 ${temp}°C\""
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "magenta",
      "text": "branch=$(omarchy-version-branch 2>/dev/null || echo 'Unknown'); echo \"$branch\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "magenta"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "magenta"
    },
    {
    "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "magenta",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Uptime / Age────────────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "green",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || echo 0); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
